# ---------- network ----------
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
# MEV-protected RPC for keeper transactions (e.g. 48 Club / BlockRazor / bloXroute protect endpoints)
PRIVATE_RPC_URL=
CHAIN_ID=56
BSCSCAN_API_KEY=
# archive RPC for `npx hardhat test test/fork.test.ts`
FORK_URL=
# behind a local HTTP proxy, Node 24 fetch needs: NODE_USE_ENV_PROXY=1 and HTTPS_PROXY=http://127.0.0.1:7890
NODE_USE_ENV_PROXY=
HTTPS_PROXY=

# ---------- deploy (scripts/deploy.ts) ----------
DEPLOYER_PRIVATE_KEY=
# Gnosis Safe on BSC: owner of the Sale + taxAdmin of the token
SAFE_ADDRESS=
# public address of the verifier signing key (plan A, single signer)
SIGNER_ADDRESS=
OFFICIAL_REFERRER=
FUND_WALLET=
# EOA receiving the 1% tax (Safe can change it at any time)
TAX_RECEIVER=
# ISO time with offset or unix seconds
SALE_START=2026-11-20T20:00:00+08:00
SALE_END=2026-11-23T20:00:00+08:00
# public campaign salt; saleSalt = keccak256(SALE_SALT), xIdHash = keccak256(saleSalt ++ xUserId)
SALE_SALT=tapecat-2026-11
# set ONEINCH_ROUTER=0x0000000000000000000000000000000000000000 to disable the backup aggregator
# ONEINCH_ROUTER=
OBS_CARDINALITY=600
# comma-separated Gelato dedicated msg.sender + self-hosted bot EOAs
INITIAL_KEEPERS=

# ---------- verifier (Express → Vercel /api OR `npm run verifier`) ----------
PORT=8787
# Same-origin Vercel (recommended): set ALL three to the production URL
#   FRONTEND_ORIGIN=https://tapecat.vercel.app
#   API_ORIGIN=https://tapecat.vercel.app
#   PUBLIC_ORIGIN=https://tapecat.vercel.app
# Local Next + verifier:
FRONTEND_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8787
PUBLIC_ORIGIN=http://localhost:8787
# CORS / Origin allowlist (comma-separated). Defaults to FRONTEND_ORIGIN; localhost:3000 always added in code.
FRONTEND_ORIGINS=http://localhost:3000
SESSION_SECRET=change-me-to-64-random-hex-chars
# Same-origin → SameSite=Lax (auto). Split domain → SameSite=None; Secure (auto).
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=1
# COOKIE_DOMAIN=
# Vercel sets TRUST_PROXY automatically via VERCEL=1 (default 1). Behind Cloudflare+nginx use 2.
TRUST_PROXY=
X_RETURN_PATH=/join
PUBLIC_RPC_URL=https://bsc-dataseed.bnbchain.org
# Optional until mainnet deploy — /api/health and /api/geo still work; signing routes return 503
SALE_ADDRESS=
SIGNER_PRIVATE_KEY=
ALLOCATION_TTL_SEC=1800
X_CLIENT_ID=
X_CLIENT_SECRET=
# Same-origin: https://YOUR_DOMAIN/api/x/callback  (must match Vercel domain / custom domain)
X_REDIRECT_URI=http://localhost:8787/api/x/callback
X_BEARER_TOKEN=
X_PROJECT_USER_ID=
X_PROJECT_HANDLE=TapeCat_
X_CAMPAIGN_TWEET_ID=
# H-01 X API guards (all optional; defaults shown). Tune refresh interval to your X plan quota.
X_REFRESH_MIN_INTERVAL_SEC=60
X_CHECK_POSITIVE_TTL_SEC=600
X_CHECK_NEGATIVE_TTL_SEC=30
X_BACKOFF_BASE_SEC=60
X_BACKOFF_MAX_SEC=900
# /api/allocation durable limits, "N/windowSec" (Turso-backed, shared by all instances)
ALLOC_RL_PER_X=6/60
ALLOC_RL_PER_IP=20/60
BLOCKED_COUNTRIES=CN,US,CU,IR,KP,SY
GEO_HEADER=cf-ipcountry
ALLOW_UNKNOWN_COUNTRY=0
# local development only, e.g. DEV_COUNTRY=SG
DEV_COUNTRY=
TERMS_VERSION=v0.10

# ---------- database (Turso / libSQL) ----------
# Local Hardhat/dev (default if unset): file:verifier/data/verifier.sqlite
# TURSO_DATABASE_URL=file:verifier/data/verifier.sqlite
# TURSO_AUTH_TOKEN=
# Vercel production: create a free DB at https://turso.tech → copy URL + token
# TURSO_DATABASE_URL=libsql://tapecat-xxxx.turso.io
# TURSO_AUTH_TOKEN=
# Legacy local path hint (only used when TURSO_DATABASE_URL is unset)
VERIFIER_DATA_DIR=verifier/data

# ---------- web (Next.js on Vercel, NOT static export) ----------
# Production Vercel: leave EMPTY so the browser calls same-origin /api/...
NEXT_PUBLIC_VERIFIER_URL=
# WalletConnect v2 mobile QR. Leave empty to hide the option entirely.
# Project id from https://cloud.reown.com — set on Vercel before building the web app.
NEXT_PUBLIC_WC_PROJECT_ID=
# Home hero GitHub button. Defaults to the public repo when unset.
NEXT_PUBLIC_GITHUB_URL=https://github.com/ddbobo1/tapecat-core
# Local `next dev` rewrite target when NEXT_PUBLIC_VERIFIER_URL is empty
VERIFIER_URL=http://127.0.0.1:8787

# ---------- keeper (keeper/src/bot.ts) ----------
KEEPER_PRIVATE_KEY=
KYBER_CLIENT_ID=tapecat
ONEINCH_API_KEY=
KEEPER_POLL_MS=15000

# ---------- allowlist export ----------
SALE_DEPLOY_BLOCK=
PINATA_JWT=
ALLOWLIST_CID=
